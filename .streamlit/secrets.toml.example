# Copy to .streamlit/secrets.toml for local use, or paste the contents into
# Streamlit Community Cloud -> Advanced settings -> Secrets.
# NEVER commit the real secrets.toml.

ANTHROPIC_API_KEY = "sk-ant-your-key-here"

# Optional: require a password before anyone can use the app
# APP_PASSWORD = "choose-a-strong-password"

# Optional: cap on Claude requests per visitor session when using YOUR key (default 30)
# MAX_AI_CALLS_PER_SESSION = "30"

# Optional: default model
# CLAUDE_MODEL = "claude-sonnet-5-5"
